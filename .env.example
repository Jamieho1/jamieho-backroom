# Copy to .env.local for local development. Never commit real values.
# Set the same two in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Contact form alert (TKT-57). Server-only: no NEXT_PUBLIC_ prefix.
# RESEND_API_KEY and IP_HASH_SALT are secrets → Sensitive in Vercel. CONTACT_ALERT_TO can be a plain variable.
RESEND_API_KEY=
CONTACT_ALERT_TO=
IP_HASH_SALT=
# Optional: only after you verify your own domain in Resend (TKT-71). Default: onboarding@resend.dev
RESEND_FROM=
# Optional: show the Settings free-tier banner early, e.g. 0.0001 to test it. Default 0.8 (80% of a limit).
FREE_TIER_WARN_AT=
